<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pairs_softuav_simulation</name>
  <version>0.1.0</version>
  <description>
    MuJoCo soft-UAV simulation (HoLoArm + Skydio X2) with a ROS 2 wrapper node
    that runs the cascaded-PID flight controller and publishes odometry/TF.
  </description>

  <maintainer email="canhthanhlt@gmail.com">PAIRS Lab</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
