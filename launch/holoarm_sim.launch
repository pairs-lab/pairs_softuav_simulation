<launch>
  <!-- Same current model, arena and Flight as the keyboard narrow-gap viewer. -->
  <arg name="gap" default="0.46"/>
  <arg name="speed" default="0.6"/>

  <node pkg="pairs_softuav_simulation" type="drone_sim_node.py"
        name="drone_sim" output="screen">
    <param name="backend" value="holoarm"/>
    <param name="holoarm_dir" value="$(find pairs_softuav_simulation)/holoarm"/>
    <param name="gap" value="$(arg gap)"/>
    <param name="speed" value="$(arg speed)"/>
    <param name="init_x"       value="0.0"/>
    <param name="init_y"       value="0.0"/>
    <param name="init_z"       value="1.2"/>
  </node>
</launch>
